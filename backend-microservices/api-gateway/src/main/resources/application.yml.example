server:
  port: 8080

spring:
  application:
    name: api-gateway
  cloud:
    gateway:
      discovery:
        locator:
          enabled: true
          lower-case-service-id: true
      routes:
        # Route 1: User & Auth Service
        - id: user-auth-service
          uri: lb://USER-AUTH-SERVICE
          predicates:
            - Path=/api/auth/**, /api/users/**, /api/consumers/**, /api/providers/**, /api/admin/users/**, /api/admin/providers/**

        # Route 2: Booking & Catalog Service
        - id: booking-catalog-service
          uri: lb://BOOKING-CATALOG-SERVICE
          predicates:
            - Path=/api/services/**, /api/provider-services/**, /api/bookings/**, /api/admin/services/**, /api/admin/bookings/**, /api/admin/logs/**

        # Route 3: Payment & Notification Service
        - id: payment-notification-service
          uri: lb://PAYMENT-NOTIFICATION-SERVICE
          predicates:
            - Path=/api/payments/**, /api/admin/payments/**, /api/notifications/**

      globalcors:
        cors-configurations:
          '[/**]':
            allowedOrigins:
              - "http://localhost:5173"
              - "YOUR_LOCAL_NETWORK_IP:5173"   # e.g. http://192.168.x.x:5173
            allowedMethods:
              - GET
              - POST
              - PUT
              - DELETE
              - OPTIONS
              - PATCH
            allowedHeaders:
              - "*"
            allowCredentials: true

eureka:
  client:
    service-url:
      defaultZone: http://localhost:8761/eureka/
  instance:
    prefer-ip-address: true
    hostname: localhost
    ip-address: 127.0.0.1

# JWT Secret - Must match the same secret used across all microservices
jwt:
  secret: YOUR_BASE64_JWT_SECRET_KEY